PANEL_LISTEN_ADDR=:8080
PANEL_DATABASE_DSN=file:panel.db?_foreign_keys=on
PANEL_GIN_MODE=debug
PANEL_CORS_ALLOWED_ORIGINS=*
PANEL_TRUSTED_PROXIES=

PANEL_TOKEN_TTL_HOURS=24
PANEL_BOOTSTRAP_ADMIN_USERNAME=admin
PANEL_BOOTSTRAP_ADMIN_PASSWORD=

PANEL_NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled
PANEL_NGINX_BACKUP_DIR=data/nginx-backups
PANEL_NGINX_SERVICE_NAME=nginx
PANEL_NGINX_COMMAND_TIMEOUT_SECONDS=10
