# Optional explicit config file path. Leave empty to use /etc/kvzd-panel/config.json.
# PANEL_CONFIG=/etc/kvzd-panel/config.json

# Environment variables override values from the JSON config.
# Uncomment only the values you want to override.
# PANEL_LISTEN_ADDR=:8080
# PANEL_DATABASE_DSN=file:/var/lib/kvzd-panel/data.db?_foreign_keys=on
# PANEL_GIN_MODE=release
# PANEL_CORS_ALLOWED_ORIGINS=*
# PANEL_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# PANEL_TOKEN_TTL_HOURS=24
# PANEL_BOOTSTRAP_ADMIN_USERNAME=admin
# PANEL_BOOTSTRAP_ADMIN_PASSWORD=

# PANEL_NGINX_SITES_ENABLED_DIR=/etc/nginx/sites-enabled
# PANEL_NGINX_BACKUP_DIR=/var/lib/kvzd-panel/nginx-backups
# PANEL_NGINX_SERVICE_NAME=nginx
# PANEL_NGINX_CONTROL_MODE=systemd
# PANEL_NGINX_COMMAND_TIMEOUT_SECONDS=10
