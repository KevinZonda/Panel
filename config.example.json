{
  // Copy this file to /etc/kvzd-panel/config.json and adjust it for your server.
  "listen_addr": ":8080",
  "database_dsn": "file:/var/lib/kvzd-panel/data.db?_foreign_keys=on",
  "gin_mode": "release",

  "cors_allowed_origins": ["*"],
  "trusted_proxies": [],
  "token_ttl_hours": 24,

  // Required only when creating the first admin user.
  "bootstrap_admin_username": "admin",
  "bootstrap_admin_password": "",

  "cert": {
    // Public (CA-signed) certificates: {public_dir}/{domain}/priv and pub.
    "public_dir": "/var/cert",
    // Self-signed certificates: {selfsign_dir}/{domain}/ca.crt, server.crt, server.key.
    "selfsign_dir": "/var/cert-self-sign",
  },

  "frp": {
    // frps TOML configs live here; names normally match frps*.service units.
    "frps_config_dir": "/etc/frps",
    // frpc TOML configs live here; names normally match frpc*.service units.
    "frpc_config_dir": "/etc/frp",
    "backup_dir": "/var/lib/kvzd-panel/frp-backups",
    "command_timeout_seconds": 10,
  },

  "nginx": {
    "sites_enabled_dir": "/etc/nginx/sites-enabled",
    "backup_dir": "/var/lib/kvzd-panel/nginx-backups",
    "service_name": "nginx",
    // "systemd" uses systemctl; "binary" controls nginx through its own
    // signals and works without any init system (containers, Alpine, BSD).
    "control_mode": "systemd",
    "command_timeout_seconds": 10,
  },
}
